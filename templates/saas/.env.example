NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY
TOSS_SECRET_KEY=YOUR_TOSS_SECRET_KEY
# F6 — billing Edge Function signs every Toss API call with TOSS_AUTH_KEY;
# without it the function returns 401 on every request.  README already
# names both keys but the env file previously only listed the secret.
TOSS_AUTH_KEY=YOUR_TOSS_AUTH_KEY
