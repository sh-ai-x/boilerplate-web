# Supabase (DB, Edge Functions, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Clerk (auth - replaces email/password + Google OAuth + Turnstile)
# Get from https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Webhook secret from dashboard -> Webhooks -> endpoint -> reveal signing secret
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Toss (billing - unchanged)
TOSS_SECRET_KEY=YOUR_TOSS_SECRET_KEY
# F6 -- billing Edge Function signs every Toss API call with TOSS_AUTH_KEY;
# without it the function returns 401 on every request.
TOSS_AUTH_KEY=YOUR_TOSS_AUTH_KEY
