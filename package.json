{
  "name": "create-boilerplate-web",
  "version": "0.1.0",
  "description": "Scaffold a Next.js + Supabase + Cloudflare + Toss template (saas, shop, or portfolio) into a target folder.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sh-ai-x/boilerplate-web.git"
  },
  "bin": {
    "create-boilerplate-web": "dist/cli.js"
  },
  "type": "commonjs",
  "main": "cli/index.js",
  "files": ["dist/**", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build:cli": "node scripts/build-cli.js",
    "prepublishOnly": "npm run build:cli",
    "test": "node --test tests/"
  },
  "keywords": [
    "boilerplate",
    "nextjs",
    "supabase",
    "cloudflare",
    "toss",
    "saas",
    "shop",
    "portfolio"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "degit": "2.8.4"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.21.5"
  }
}
