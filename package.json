{
  "name": "create-boilerplate-web",
  "version": "0.1.0",
  "description": "Scaffold a Next.js + Supabase + Cloudflare + Toss template (saas, shop, or portfolio) into a target folder.",
  "bin": {
    "create-boilerplate-web": "cli/index.js"
  },
  "type": "commonjs",
  "main": "cli/index.js",
  "files": [
    "cli",
    "README.md",
    "templates.lock.json"
  ],
  "scripts": {
    "build:cli": "node scripts/build-cli.js",
    "test": "node --test tests/",
    "test:scaffold": "bash scripts/e2e-scaffold-test.sh"
  },
  "keywords": [
    "boilerplate",
    "nextjs",
    "supabase",
    "cloudflare",
    "toss",
    "saas",
    "shop",
    "portfolio"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "degit": "2.8.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "license": "MIT"
}
