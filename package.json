{
  "name": "create-boilerplate-web",
  "version": "0.1.0",
  "description": "Scaffold a Next.js + Supabase + Cloudflare + Toss boilerplate (saas / shop / portfolio).",
  "repository": {
    "type": "git",
    "url": "https://github.com/sanghee-dev/boilerplate-web.git"
  },
  "bugs": {
    "url": "https://github.com/sanghee-dev/boilerplate-web/issues"
  },
  "homepage": "https://github.com/sanghee-dev/boilerplate-web#readme",
  "bin": {
    "create-boilerplate-web": "dist/cli.js"
  },
  "type": "commonjs",
  "files": [
    "dist",
    "templates",
    "cloudflare-rules.json",
    "templates.lock.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build:cli": "tsc -p cli/tsconfig.json",
    "pretest": "npm run build:cli",
    "prepublishOnly": "npm run build:cli",
    "test": "node --test tests/*.test.js",
    "test:scaffold": "bash scripts/e2e-scaffold-test.sh"
  },
  "keywords": [
    "boilerplate",
    "nextjs",
    "supabase",
    "cloudflare",
    "toss",
    "saas",
    "ecommerce",
    "portfolio",
    "create-boilerplate-web"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "degit": "2.8.4"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
